# Ports on your computer
BACKEND_PORT=8000
FRONTEND_PORT=5173
MOON_SKY_PORT=3001

# Frontend: where the browser finds the backend
VITE_BACKEND_URL=http://localhost:8000

# Frontend: where the browser finds the Lunar Sky API (moon-sky service)
VITE_MOON_SKY_URL=http://localhost:3001

# Backend: which websites may call the API (must be JSON list format)
CORS_ORIGINS=["http://localhost:5173"]

# Hot reload on Windows + Docker
WATCHFILES_FORCE_POLLING=true
